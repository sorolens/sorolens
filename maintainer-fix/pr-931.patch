+			Date:       bucket.Day.UTC().Format("2006-01-02"),
+			AvgCPUInsn: bucket.AvgCPUInsn,
+			AvgMemByte: bucket.AvgMemByte,
+			AvgFee:     bucket.AvgFee,
+			Count:      bucket.Count,
+		}
+	}
+	writeJSON(w, http.StatusOK, map[string]any{
+		"days":   days,
+		"points": points,
+	})
+}
