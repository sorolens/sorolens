diff --git a/apps/web/tests/fixtures.openapi.test.ts b/apps/web/tests/fixtures.openapi.test.ts
new file mode 100644
index 0000000..6a57ab8
--- /dev/null
+++ b/apps/web/tests/fixtures.openapi.test.ts
@@ -0,0 +1,105 @@
+/**
+ * Fixture/spec drift guard (issue #599).
+ *
+ * Playwright mocks responses by hand. Those fixtures drifted from the API
+ * before, so every fixture that stands in for a documented response is
+ * validated against docs/openapi.yaml here. A spec change that the fixtures do
+ * not follow fails this test instead of surfacing only in a browser run.
+ */
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import Ajv from "ajv";
+import yaml from "js-yaml";
+import { describe, expect, it } from "vitest";
+import {
+  contractDetail,
+  contractEvent,
+  contractInvocation,
+  resourceTrendResponse,
+} from "./e2e/helpers";
+
+const specPath = resolve(__dirname, "../../../docs/openapi.yaml");
+const spec = yaml.load(readFileSync(specPath, "utf8")) as Record<string, any>;
+
+const ajv = new Ajv({ strict: false, allErrors: true });
+// OpenAPI numeric formats are annotations; JSON numbers already cover them.
+ajv.addFormat("double", true);
+ajv.addFormat("int64", true);
+ajv.addFormat("int32", true);
+ajv.addFormat("date-time", true);
+
+/** Resolves local JSON pointers and converts OpenAPI `nullable` to JSON Schema. */
+function normalize(node: any, seen = new Set<string>()): any {
+  if (Array.isArray(node)) return node.map((item) => normalize(item, seen));
+  if (!node || typeof node !== "object") return node;
+
+  if (typeof node.$ref === "string" && node.$ref.startsWith("#/")) {
+    if (seen.has(node.$ref)) return {};
+    const target = node.$ref
+      .slice(2)
+      .split("/")
+      .reduce((value: any, key: string) => value?.[key], spec);
+    return normalize(target, new Set([...seen, node.$ref]));
+  }
+
+  const out: Record<string, any> = {};
+  for (const [key, value] of Object.entries(node)) {
+    if (key === "nullable") continue;
+    out[key] = normalize(value, seen);
+  }
+  if (node.nullable && typeof out.type === "string") {
+    out.type = [out.type, "null"];
+  }
+  return out;
+}
+
+function validateFixture(name: string, body: unknown, schema: unknown) {
+  const validate = ajv.compile(normalize(schema));
+  const ok = validate(body);
+  expect(
+    ok,
+    `${name} does not match the OpenAPI schema: ${JSON.stringify(
+      validate.errors,
+      null,
+      2
+    )}`
+  ).toBe(true);
+}
+
+const operationResponse = (path: string, operation: string) =>
+  spec.paths[path][operation].responses["200"].content["application/json"]
+    .schema;
+
+describe("Playwright fixtures match docs/openapi.yaml", () => {
+  it("contract detail matches the Contract schema", () => {
+    validateFixture(
+      "contractDetail",
+      contractDetail(),
+      spec.components.schemas.Contract
+    );
+  });
+
+  it("contract event matches the Event schema", () => {
+    validateFixture(
+      "contractEvent",
+      contractEvent(),
+      spec.components.schemas.Event
+    );
+  });
+
+  it("contract invocation matches the Invocation schema", () => {
+    validateFixture(
+      "contractInvocation",
+      contractInvocation(),
+      spec.components.schemas.Invocation
+    );
+  });
+
+  it("resource trend matches the documented response", () => {
+    validateFixture(
+      "resourceTrendResponse",
+      resourceTrendResponse(),
+      operationResponse("/api/v1/contracts/{id}/resource-trend", "get")
+    );
+  });
+});
diff --git a/apps/web/vitest.setup.ts b/apps/web/vitest.setup.ts
index 619cdcc..b077431 100644
--- a/apps/web/vitest.setup.ts
+++ b/apps/web/vitest.setup.ts
@@ -57,3 +57,22 @@ Object.defineProperty(globalThis, "localStorage", {
   writable: true,
   configurable: true,
 });
+
+// cmdk observes its list with ResizeObserver, which jsdom does not implement.
+if (typeof globalThis.ResizeObserver === "undefined") {
+  class ResizeObserverStub {
+    observe() {}
+    unobserve() {}
+    disconnect() {}
+  }
+  Object.defineProperty(globalThis, "ResizeObserver", {
+    value: ResizeObserverStub,
+    writable: true,
+    configurable: true,
+  });
+}
+
+// cmdk scrolls the active option into view; jsdom does not implement layout.
+if (typeof Element !== "undefined" && !Element.prototype.scrollIntoView) {
+  Element.prototype.scrollIntoView = function scrollIntoView() {};
+}
diff --git a/deploy/minio/Dockerfile b/deploy/minio/Dockerfile
new file mode 100644
index 0000000..73c253b
--- /dev/null
+++ b/deploy/minio/Dockerfile
@@ -0,0 +1,27 @@
+# syntax=docker/dockerfile:1
+# Build from the repository root. MinIO publishes this release as source.
+FROM golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab AS builder
+ENV CGO_ENABLED=0 GOBIN=/out GOTOOLCHAIN=local
+RUN go install -trimpath -ldflags="-s -w \
+    -X github.com/minio/minio/cmd.Version=2025-10-15T17:29:55Z \
+    -X github.com/minio/minio/cmd.ReleaseTag=RELEASE.2025-10-15T17-29-55Z \
+    -X github.com/minio/minio/cmd.CommitID=9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a \
+    -X github.com/minio/minio/cmd.ShortCommitID=9e49d5e7a648" \
+    github.com/minio/minio@9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a
+RUN go install -trimpath -ldflags="-s -w \
+    -X github.com/minio/mc/cmd.Version=2025-08-13T08:35:41Z \
+    -X github.com/minio/mc/cmd.ReleaseTag=RELEASE.2025-08-13T08-35-41Z \
+    -X github.com/minio/mc/cmd.CommitID=7394ce0dd2a80935aded936b09fa12cbb3cb8096 \
+    -X github.com/minio/mc/cmd.ShortCommitID=7394ce0dd2a8" \
+    github.com/minio/mc@7394ce0dd2a80935aded936b09fa12cbb3cb8096
+COPY scripts/container-healthcheck/main.go /tmp/healthcheck.go
+RUN go build -trimpath -ldflags="-s -w" -o /out/healthcheck /tmp/healthcheck.go && mkdir /out/data
+
+FROM gcr.io/distroless/base-debian12:nonroot@sha256:7f0c72cd138b442ae0deeb69c08b1acf5525439ba251a49ad93c320a061567e5
+COPY --from=builder /out/minio /out/mc /out/healthcheck /usr/local/bin/
+COPY --from=builder --chown=nonroot:nonroot /out/data/ /data/
+USER nonroot:nonroot
+EXPOSE 9000 9001
+HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 \
+  CMD ["/usr/local/bin/healthcheck", "MINIO_PORT", "9000", "/minio/health/live"]
+ENTRYPOINT ["/usr/local/bin/minio"]
