diff --git a/apps/web/components/EmptyState.test.tsx b/apps/web/components/EmptyState.test.tsx
new file mode 100644
index 0000000..56778be
--- /dev/null
+++ b/apps/web/components/EmptyState.test.tsx
@@ -0,0 +1,90 @@
+import * as matchers from "@testing-library/jest-dom/matchers";
+import { cleanup, fireEvent, render, screen } from "@testing-library/react";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import { EmptyState } from "@/components/EmptyState";
+
+expect.extend(matchers);
+
+describe("EmptyState", () => {
+  afterEach(() => {
+    cleanup();
+  });
+
+  it("renders a first-run empty state as a polite status with copy", () => {
+    render(
+      <EmptyState
+        title="No contracts tracked yet"
+        description="Track a contract to get started."
+      />
+    );
+
+    const status = screen.getByRole("status");
+    expect(status).toHaveAttribute("data-empty-variant", "first-run");
+    expect(status).toHaveTextContent("No contracts tracked yet");
+    expect(status).toHaveTextContent("Track a contract to get started.");
+    expect(screen.queryByRole("alert")).toBeNull();
+  });
+
+  it("distinguishes a filtered no-results state from a first run", () => {
+    render(<EmptyState variant="no-results" title="No matches" />);
+
+    expect(screen.getByRole("status")).toHaveAttribute(
+      "data-empty-variant",
+      "no-results"
+    );
+  });
+
+  it("links the next action to its route", () => {
+    render(
+      <EmptyState
+        title="No contracts tracked yet"
+        action={{ label: "Track a contract", href: "/contracts/new" }}
+      />
+    );
+
+    expect(
+      screen.getByRole("link", { name: "Track a contract" })
+    ).toHaveAttribute("href", "/contracts/new");
+  });
+
+  it("calls onClick for a button action", () => {
+    const onClick = vi.fn();
+    render(
+      <EmptyState
+        variant="no-results"
+        title="No matches"
+        action={{ label: "Clear filters", onClick }}
+      />
+    );
+
+    fireEvent.click(screen.getByRole("button", { name: "Clear filters" }));
+
+    expect(onClick).toHaveBeenCalledTimes(1);
+  });
+
+  it("renders no action without one", () => {
+    render(<EmptyState title="Nothing here yet" />);
+
+    expect(screen.queryByRole("button")).toBeNull();
+    expect(screen.queryByRole("link")).toBeNull();
+  });
+
+  it("delegates the error variant to ErrorState with a retry", () => {
+    const onRetry = vi.fn();
+    render(
+      <EmptyState
+        variant="error"
+        title="Couldn't load contracts."
+        message="API down"
+        onRetry={onRetry}
+      />
+    );
+
+    const alert = screen.getByRole("alert");
+    expect(alert).toHaveTextContent("Couldn't load contracts.");
+    expect(alert).toHaveTextContent("API down");
+
+    fireEvent.click(screen.getByRole("button", { name: "Try again" }));
+    expect(onRetry).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/apps/web/components/EmptyState.tsx b/apps/web/components/EmptyState.tsx
new file mode 100644
index 0000000..2223add
--- /dev/null
+++ b/apps/web/components/EmptyState.tsx
@@ -0,0 +1,119 @@
+"use client";
+
+import type { ReactNode } from "react";
+import Link from "next/link";
+import { ErrorState } from "@/components/ErrorState";
+
+export type EmptyStateVariant = "first-run" | "no-results" | "error";
+
+export interface EmptyStateAction {
+  /** Visible label for the link or button. */
+  label: string;
+  /** Renders a link to this route instead of a button. */
+  href?: string;
+  /** Runs when the action is a button. */
+  onClick?: () => void;
+  /** Optional id so tests and shortcuts can target the action. */
+  id?: string;
+}
+
+export interface EmptyStateProps {
+  /**
+   * `first-run` (nothing exists yet), `no-results` (data exists but the
+   * filters match nothing) or `error` (the request failed).
+   */
+  variant?: EmptyStateVariant;
+  /** Headline. Page-specific copy, taken from the i18n catalog. */
+  title: ReactNode;
+  /** Optional explanation, action hints and inline links. */
+  description?: ReactNode;
+  /** The single next action the empty state offers. */
+  action?: EmptyStateAction;
+  /** Error detail, only used by the error variant. */
+  message?: string | null;
+  /** Retry handler, only used by the error variant. */
+  onRetry?: () => void;
+  retrying?: boolean;
+  retryLabel?: string;
+  /** Smaller padding for empty states inside a card or section. */
+  compact?: boolean;
+  className?: string;
+}
+
+const actionClass =
+  "inline-flex items-center rounded-md border border-[var(--color-border)] px-3 py-1.5 text-sm font-medium text-[var(--color-text-primary)] transition-colors hover:border-[var(--color-accent)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-accent)]";
+
+/**
+ * Shared placeholder for a list with nothing to show. It distinguishes a
+ * first run (nothing exists yet) from filters that match nothing, and its
+ * `error` variant delegates to ErrorState so a failed request is never
+ * mistaken for an empty list. Copy comes from the i18n catalog at the call
+ * site, so every page explains itself and offers one next action.
+ */
+export function EmptyState({
+  variant = "first-run",
+  title,
+  description,
+  action,
+  message,
+  onRetry,
+  retrying = false,
+  retryLabel,
+  compact = false,
+  className = "",
+}: EmptyStateProps) {
+  if (variant === "error") {
+    return (
+      <ErrorState
+        title={typeof title === "string" ? title : undefined}
+        message={message}
+        onRetry={onRetry}
+        retrying={retrying}
+        retryLabel={retryLabel}
+        compact={compact}
+        className={className}
+      />
+    );
+  }
+
+  return (
+    <div
+      role="status"
+      data-empty-variant={variant}
+      className={`rounded-lg border border-[var(--color-border)] bg-[var(--color-bg-card)] text-center ${
+        variant === "no-results" ? "border-dashed" : ""
+      } ${compact ? "p-6" : "px-8 py-16"} ${className}`.trim()}
+    >
+      <p className="text-lg font-medium text-[var(--color-text-primary)]">
+        {title}
+      </p>
+      {description && (
+        <div className="mt-2 text-sm text-[var(--color-text-secondary)]">
+          {description}
+        </div>
+      )}
+      {action && (
+        <div className="mt-4">
+          {action.href ? (
+            <Link
+              href={action.href}
+              id={action.id}
+              className={`${actionClass} no-underline`}
+            >
+              {action.label}
+            </Link>
+          ) : (
+            <button
+              type="button"
+              id={action.id}
+              onClick={action.onClick}
+              className={actionClass}
+            >
+              {action.label}
+            </button>
+          )}
+        </div>
+      )}
+    </div>
+  );
+}
