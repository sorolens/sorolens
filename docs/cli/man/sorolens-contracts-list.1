.nh
.TH "SOROLENS" "1" "Nov 2026" "" ""

.SH NAME
sorolens-contracts-list - List tracked contracts


.SH SYNOPSIS
\fBsorolens contracts list [flags]\fP


.SH DESCRIPTION
List the contracts tracked by the Sorolens API on the selected network.

.PP
Use --network to choose the network (default: testnet), --limit to cap the
number of rows, and --json for machine-readable output.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--limit\fP=50
	Maximum number of contracts to list


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-key\fP=""
	API key for authenticating with the Sorolens API

.PP
\fB--api-url\fP=""
	Sorolens API base URL

.PP
\fB--json\fP[=false]
	Output machine-readable JSON

.PP
\fB--network\fP=""
	Stellar network (testnet, mainnet, futurenet, standalone)

.PP
\fB--no-color\fP[=false]
	Disable color output

.PP
\fB--output\fP=""
	Output format (table, json, yaml or jsonl)

.PP
\fB--plugin-api-key\fP[=false]
	When dispatching to a plugin, pass the active profile's API key as SOROLENS_API_KEY (off by default)

.PP
\fB--profile\fP=""
	Configuration profile name (default: $SOROLENS_PROFILE, then the default profile)

.PP
\fB--query\fP=""
	jq-style path filter applied to structured output (e.g. '.items[].name')

.PP
\fB--timeout\fP=10s
	Request timeout


.SH EXAMPLE
.EX
  sorolens contracts list
  sorolens contracts list --network mainnet --limit 10
  sorolens contracts list --json
.EE


.SH SEE ALSO
\fBsorolens-contracts(1)\fP
