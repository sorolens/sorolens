# ==============================================================================
# SoroLens Web Dashboard Environment Variables (apps/web)
# ==============================================================================
# Variables prefixed with NEXT_PUBLIC_ are inlined at build time and exposed to
# the browser. All other variables are server-only secrets/settings.
# Copy this file to .env.local for local development.
# ==============================================================================

# ---- App & API Endpoints -----------------------------------------------------

# Public base URL of the SoroLens REST API backend.
# Required/Optional: Optional.
# Default: http://localhost:8080
# Exposed to browser: Yes (NEXT_PUBLIC_*)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Server-side API endpoint override/fallback. Used by server-side data fetching
# routines (e.g. server components). Falls back to NEXT_PUBLIC_API_URL if unset.
# Required/Optional: Optional.
# Default: http://localhost:8080 (or NEXT_PUBLIC_API_URL)
# Exposed to browser: No (server-only)
API_URL=http://localhost:8080

# Canonical public origin of the web application. Used in robots.txt to construct
# sitemap and host URLs.
# Required/Optional: Optional.
# Default: https://sorolens.dev
# Exposed to browser: Yes (NEXT_PUBLIC_*)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Canonical public domain / base URL of the dashboard. Used in sitemap.xml generation.
# Required/Optional: Optional.
# Default: http://localhost:3000
# Exposed to browser: Yes (NEXT_PUBLIC_*)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Progressive Web App (PWA) ----------------------------------------------

# Enables Progressive Web App (PWA) service worker generation and registration in
# development mode when set to "true". In production (NODE_ENV=production), the
# service worker is always enabled unless explicitly disabled.
# Required/Optional: Optional.
# Default: false
# Exposed to browser: Yes (NEXT_PUBLIC_*)
NEXT_PUBLIC_PWA_ENABLED=false

# ---- Web Push Notifications --------------------------------------------------

# Base64url-encoded 65-byte uncompressed EC P-256 public key for Web Push.
# Shared with browser clients via /api/push/key to subscribe to notifications.
# Required/Optional: Optional in development; required if Web Push is enabled.
# Default: none
# Exposed to browser: Yes (via /api/push/key API endpoint)
# Generate a keypair with: npx web-push generate-vapid-keys
# Example: BEl62iUYgUivxIkv69yViEuiBIa-Ib9-Skv6_example_public_key_only
VAPID_PUBLIC_KEY=

# Base64url-encoded 32-byte EC P-256 private key for Web Push.
# Used on the server to sign Web Push payloads.
# SERVER-ONLY SECRET: Must NEVER be committed to version control or exposed publicly.
# Required/Optional: Optional in development; required if Web Push is enabled.
# Default: none
# Exposed to browser: No (server-only secret)
# Generate a keypair with: npx web-push generate-vapid-keys
# Example: fake_vapid_private_key_do_not_use_in_prod
VAPID_PRIVATE_KEY=

# Contact URI (mailto: or https:) for the VAPID JWT 'sub' claim.
# Allows push services to contact the application operator.
# Required/Optional: Optional.
# Default: mailto:admin@sorolens.dev
# Exposed to browser: No (server-only)
VAPID_SUBJECT=mailto:admin@sorolens.dev

# Shared secret token guarding the internal PUT /api/push/subscribe endpoint
# (checked against the x-push-secret request header) for dispatching alerts.
# SERVER-ONLY SECRET: Must NEVER be committed to version control or exposed publicly.
# Set to a long random secret before enabling push notifications in production.
# Required/Optional: Optional in development; required in production.
# Default: none (unauthenticated in development)
# Exposed to browser: No (server-only secret)
# Example: replace_with_a_secure_random_internal_secret
PUSH_INTERNAL_SECRET=

# ---- Monitoring & Analytics --------------------------------------------------

# Sentry DSN for client-side frontend error reporting and performance tracing.
# Leave unset or empty to completely disable Sentry error reporting.
# Required/Optional: Optional.
# Default: none (reporting disabled)
# Exposed to browser: Yes (NEXT_PUBLIC_*)
# Example: https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=

# Domain name for privacy-preserving Plausible Analytics (e.g. sorolens.dev).
# Injected via a lightweight script only in production builds (NODE_ENV=production).
# Leave unset or empty to disable analytics.
# Required/Optional: Optional.
# Default: none (analytics disabled)
# Exposed to browser: Yes (NEXT_PUBLIC_*)
# Example: sorolens.dev
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Prometheus /metrics endpoint of the indexer service. Scraped server-side by the
# /api/status/indexer route handler to display sync lag and ledger progress.
# Required/Optional: Optional.
# Default: http://localhost:9100/metrics
# Exposed to browser: No (server-only)
INDEXER_METRICS_URL=http://localhost:9100/metrics

# Public fallback alias for the indexer Prometheus /metrics endpoint.
# Used by /api/status/indexer if INDEXER_METRICS_URL is unset.
# Required/Optional: Optional.
# Default: http://localhost:9100/metrics
# Exposed to browser: Yes (NEXT_PUBLIC_*)
NEXT_PUBLIC_INDEXER_METRICS_URL=http://localhost:9100/metrics

# ---- Testing (E2E) -----------------------------------------------------------

# Port of the backend API server used by Playwright during E2E test runs (pnpm test:e2e).
# Required/Optional: Optional.
# Default: 8080
# Exposed to browser: No (test runner only)
API_PORT=8080
