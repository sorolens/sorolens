    "@tanstack/react-virtual": "^3.14.21",
    "cmdk": "^1.1.1",
    "idb": "^8.0.3",
    "next": "^15.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3",
    "swr": "^2.5.1",
    "use-debounce": "^10.1.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.3.1",
    "@playwright/test": "^1.63.0",
