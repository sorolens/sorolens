# Sorolens Discord contributor bot - environment variables

# ---- Discord ---------------------------------------------------------------

# Bot token from https://discord.com/developers/applications/<app>/bot
DISCORD_BOT_TOKEN=

# Application id (also known as Client ID) from Discord dev portal.
DISCORD_CLIENT_ID=

# Server (guild) id where the bot operates. In Discord: right-click server icon,
# Copy Server ID. Requires Developer Mode enabled in User Settings > Advanced.
DISCORD_GUILD_ID=

# Role ids for the two tiers the bot auto-grants. Right-click each role and
# Copy Role ID.
DISCORD_ROLE_CONTRIBUTOR_ID=
DISCORD_ROLE_CORE_CONTRIBUTOR_ID=

# Optional. If set, /connect grants this role after successful OAuth
# link. Used to gate the community behind GitHub verification: hide
# most channels from @everyone, show them only to holders of this role.
# Discord's built-in Onboarding must be reconfigured to NOT auto-grant
# this role; the bot becomes the sole granter.
DISCORD_ROLE_VERIFIED_ID=

# ---- Tier thresholds ------------------------------------------------------

# Contributors need at least this many merged PRs against GITHUB_REPO.
CONTRIBUTOR_THRESHOLD=1
CORE_CONTRIBUTOR_THRESHOLD=3

# ---- GitHub ---------------------------------------------------------------

# Fine-grained PAT with read access to sorolens/sorolens. Only needs
# `metadata: read` and `pull_requests: read`; no write scopes.
GITHUB_TOKEN=

# Repository the bot counts merged PRs against.
GITHUB_REPO=sorolens/sorolens

# Shared secret you set on the GitHub webhook. Random 32+ char string.
GITHUB_WEBHOOK_SECRET=

# ---- GitHub OAuth (for /connect) -----------------------------------------

# Create an OAuth App at https://github.com/settings/developers:
#   Homepage URL           = value of PUBLIC_BASE_URL below
#   Authorization callback = ${PUBLIC_BASE_URL}/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# HMAC key that signs the short-lived OAuth state + the personal
# /oauth/start links the bot generates. Random 32+ char string.
OAUTH_STATE_SECRET=

# Publicly reachable base URL of this bot. Used as the OAuth callback
# and inside /connect links. No trailing slash.
PUBLIC_BASE_URL=https://sorolens.onrender.com

# ---- Sorolens API (for /status, /alerts, /watch, /unwatch) ---------------

# Base URL of the Sorolens HTTP API.
SOROLENS_API_BASE_URL=http://localhost:8080

# Optional. An API key with the `admin:*` scope, minted once from the
# dashboard or `POST /api/v1/api-keys`. When set, /connect mints a
# per-contributor key so each query command authenticates as that user.
# Leave empty to run the commands on the API's public read surface.
SOROLENS_API_KEY=

# Per-user slash command budget, sliding 60s window. Default 10.
COMMAND_RATE_LIMIT_PER_MINUTE=10

# ---- HTTP -----------------------------------------------------------------

# Port the webhook receiver listens on. Railway sets this automatically.
PORT=8080

# ---- Storage --------------------------------------------------------------

# SQLite database file. On Render's free tier there is no persistent
# disk, so we point this at /tmp (writable, but wiped on redeploy).
# Contributors can simply run /link again after a redeploy.
# On a platform with a persistent disk (Render paid, Fly, a VPS),
# mount a volume and point this at a stable path like /data/mappings.db.
DATABASE_PATH=/tmp/mappings.db
